# Testing User Switcher
# Set this to 'true' in development to enable the Testing User Context switcher panel
# This allows you to quickly switch between test users without requiring authentication
# For production builds, leave this unset or set to 'false'
REACT_APP_ENABLE_TEST_USER_SWITCHER=true

# Backend API
# Set the backend API endpoint (optional, defaults to http://localhost:5000/api)
REACT_APP_API_BASE=http://localhost:5000/api
